---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Javier Moreno — Full-Stack Engineer & Product Builder", 
	description = "Desarrollo productos digitales de punta a punta: plataformas e-commerce desde cero, backends robustos y diseño de interfaces de alto impacto." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth antialiased dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
		<meta name="theme-color" content="#090a0f" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<!-- Fuentes: Plus Jakarta Sans (titulares y cuerpo) y JetBrains Mono (detalles técnicos) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#090a0f] text-zinc-100 font-sans selection:bg-lime-400 selection:text-black min-h-screen flex flex-col relative overflow-x-hidden">
		<slot />
	</body>
</html>
