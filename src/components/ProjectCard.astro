---
// ProjectCard.astro - Industrial Technical Project Showcase Card
interface Props {
	id: string;
	titulo: string;
	subtitulo: string;
	descripcion: string;
	tags: string[];
	estado: string;
	link: string;
	destacado?: boolean;
}

const {
	id,
	titulo,
	subtitulo,
	descripcion,
	tags,
	estado,
	link = "#",
	destacado = false
} = Astro.props;
---

<article 
	class={`group relative rounded-xl border transition-all duration-300 flex flex-col justify-between overflow-hidden ${
		destacado 
			? 'border-lime-400/40 bg-zinc-900/50 shadow-lg shadow-lime-400/5' 
			: 'border-zinc-800/80 bg-zinc-900/30 hover:border-zinc-700 hover:bg-zinc-900/50'
	}`}
>
	<!-- Card Header / Meta bar -->
	<div class="px-5 pt-5 pb-4 border-b border-zinc-800/60 flex items-center justify-between">
		<div class="flex items-center gap-2">
			<span class="font-mono text-xs text-lime-400 font-semibold">[{id}]</span>
			<span class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider">{subtitulo}</span>
		</div>
		<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-widest border border-zinc-800 bg-[#090a0f] text-zinc-400">
			<span class={`w-1.5 h-1.5 rounded-full ${estado === 'Producción' || estado === 'Disponible' ? 'bg-lime-400' : 'bg-amber-400'}`}></span>
			<span>{estado}</span>
		</span>
	</div>

	<!-- Card Body -->
	<div class="p-5 flex-1 flex flex-col justify-between">
		<div>
			<h3 class="text-xl font-bold text-white tracking-tight group-hover:text-lime-300 transition-colors flex items-center justify-between">
				<span>{titulo}</span>
				<span class="text-zinc-600 group-hover:text-lime-400 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
					&nearr;
				</span>
			</h3>
			<p class="mt-3 text-sm text-zinc-400 leading-relaxed font-normal">
				{descripcion}
			</p>
		</div>

		<!-- Tech stack tags & Link -->
		<div class="mt-6 pt-4 border-t border-zinc-800/50 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
			<div class="flex flex-wrap gap-1.5">
				{tags.map((tag) => (
					<span class="text-[11px] font-mono text-zinc-400 bg-zinc-950/90 px-2 py-0.5 rounded border border-zinc-800/70">
						{tag}
					</span>
				))}
			</div>
			
			<a 
				href={link} 
				target={link.startsWith('http') ? "_blank" : undefined}
				rel={link.startsWith('http') ? "noopener noreferrer" : undefined}
				class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-300 group-hover:text-lime-400 transition-colors py-1 shrink-0"
			>
				<span>Consultar proyecto</span>
				<span>&rarr;</span>
			</a>
		</div>
	</div>
</article>
