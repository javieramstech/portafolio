---
// WhatsAppButton.astro - Botón Flotante Sutil & Minimalista (Mobile First)
interface Props {
	phone?: string;
	message?: string;
}

const {
	phone = "56912345678", // Reemplazar con tu número de WhatsApp real con código de país
	message = "Hola Javier, vi tu portafolio y me gustaría conversar sobre un proyecto web/ecommerce."
} = Astro.props;

const whatsappUrl = `https://wa.me/${phone.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(message)}`;
---

<!-- Botón Flotante Sutil (Estética Industrial & Técnica) -->
<aside 
	aria-label="Contacto por WhatsApp" 
	class="fixed bottom-5 right-4 sm:bottom-6 sm:right-6 z-40 flex items-center group"
>
	<a 
		href={whatsappUrl} 
		target="_blank" 
		rel="noopener noreferrer" 
		class="flex items-center gap-2.5 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-full border border-zinc-700/80 bg-[#0c0e14]/90 backdrop-blur-md text-zinc-200 hover:text-white hover:border-lime-400/60 transition-all duration-300 shadow-xl shadow-black/40 glow-lime-sm active:scale-95"
	>
		<!-- Indicador de estado en vivo -->
		<span class="relative flex h-2 w-2">
			<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
			<span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
		</span>

		<!-- Icono SVG de WhatsApp vectorizado -->
		<svg class="w-4 h-4 text-emerald-400 fill-current" viewBox="0 0 24 24">
			<path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.83.81 2.796.81 3.183 0 5.769-2.588 5.77-5.768.001-3.182-2.585-5.794-5.77-5.794zm3.364 8.167c-.14.394-.808.751-1.121.789-.313.039-.707.054-2.072-.511-1.745-.724-2.871-2.496-2.958-2.612-.087-.116-.708-.941-.708-1.795 0-.853.447-1.274.607-1.448.16-.174.348-.218.464-.218.116 0 .232.001.333.006.107.005.25.04.385.367.14.339.479 1.168.521 1.255.042.087.07.189.012.305-.058.116-.087.189-.174.291-.087.102-.183.228-.261.306-.087.087-.178.182-.077.355.101.174.45 0.742.966 1.202.664.591 1.224.774 1.398.861.174.087.276.073.378-.044.102-.116.435-.508.551-.682.116-.174.232-.145.392-.087.16.058 1.015.479 1.189.566.174.087.29.131.333.204.043.073.043.421-.097.815zM12.042 2C6.5 2 2 6.5 2 12.042c0 1.984.58 3.834 1.583 5.399L2 22l4.693-1.536c1.517.937 3.303 1.478 5.349 1.478 5.542 0 10.042-4.5 10.042-10.042C22.084 6.5 17.584 2 12.042 2z"/>
		</svg>

		<span class="text-xs font-mono font-medium tracking-tight text-zinc-300 group-hover:text-white">
			WhatsApp
		</span>

		<span class="text-[10px] font-mono text-zinc-500 hidden sm:inline">
			[Directo]
		</span>
	</a>
</aside>
