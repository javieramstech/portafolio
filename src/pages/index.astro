];
---

<Layout title="Javier Moreno — Full Stack Developer & Product Builder">
	<Navbar />

	<main class="flex-1">
		<!-- Hero Section con Canvas Interactivo Táctil -->
		<section 
			id="hero-section" 
			class="relative min-h-[88vh] sm:min-h-[92vh] flex items-center justify-center px-4 sm:px-6 pt-16 pb-20 overflow-hidden bg-tech-grid"
		>
			<HeroCanvas />

			<!-- Contenedor de contenido Hero (Mobile First) -->
			<div class="relative z-10 max-w-5xl mx-auto text-center flex flex-col items-center">
				<!-- Live System Status Badge -->
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-mono border border-zinc-800 bg-zinc-900/80 text-zinc-300 mb-8 backdrop-blur-md glow-lime-sm">
					<span class="w-2 h-2 rounded-full bg-lime-400 animate-pulse"></span>
					<span class="text-lime-400 font-semibold">[DISPONIBLE]</span>
					<span class="text-zinc-500">|</span>
					<span>Atención directa por WhatsApp</span>
				</div>

				<!-- Titular Principal Claro y Comercial -->
				<h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white leading-[1.08] max-w-4xl text-balance">
					Creo páginas web y <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-100 to-zinc-400">tiendas online</span> diseñadas para <span class="text-lime-400 underline decoration-lime-400/40 decoration-wavy decoration-1 underline-offset-8">vender más</span>.
				</h1>

				<!-- Subtítulo comprensible para cualquier cliente -->
				<p class="mt-6 text-base sm:text-xl text-zinc-300 max-w-2xl font-normal leading-relaxed text-pretty">
					<strong class="text-white font-semibold">Full Stack Developer & Product Builder</strong>. Me encargo de todo tu proyecto de punta a punta: diseño visual atractivo, tienda con cobro con tarjeta y máxima velocidad en celulares. Sin plantillas lentas ni complicaciones técnicas.
				</p>

				<!-- Botones de Acción Táctiles (Móvil Primero con min 48px de altura) -->
				<div class="mt-8 sm:mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4 w-full sm:w-auto items-stretch sm:items-center justify-center font-mono">
					<a 
						href="https://wa.me/5491170603106?text=Hola%20Javier,%20estuve%20viendo%20tu%20web%20y%20me%20gustar%C3%ADa%20consultarte%20por%20un%20proyecto" 
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl bg-lime-400 hover:bg-lime-300 text-black font-bold text-xs uppercase tracking-wider transition-all duration-200 glow-lime active:scale-95 shadow-lg shadow-lime-400/10"
					>
						<!-- Icono WhatsApp -->
