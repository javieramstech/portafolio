							<path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.83.81 2.796.81 3.183 0 5.769-2.588 5.77-5.768.001-3.182-2.585-5.794-5.77-5.794zm3.364 8.167c-.14.394-.808.751-1.121.789-.313.039-.707.054-2.072-.511-1.745-.724-2.871-2.496-2.958-2.612-.087-.116-.708-.941-.708-1.795 0-.853.447-1.274.607-1.448.16-.174.348-.218.464-.218.116 0 .232.001.333.006.107.005.25.04.385.367.14.339.479 1.168.521 1.255.042.087.07.189.012.305-.058.116-.087.189-.174.291-.087.102-.183.228-.261.306-.087.087-.178.182-.077.355.101.174.45 0.742.966 1.202.664.591 1.224.774 1.398.861.174.087.276.073.378-.044.102-.116.435-.508.551-.682.116-.174.232-.145.392-.087.16.058 1.015.479 1.189.566.174.087.29.131.333.204.043.073.043.421-.097.815zM12.042 2C6.5 2 2 6.5 2 12.042c0 1.984.58 3.834 1.583 5.399L2 22l4.693-1.536c1.517.937 3.303 1.478 5.349 1.478 5.542 0 10.042-4.5 10.042-10.042C22.084 6.5 17.584 2 12.042 2z"/>
						</svg>
						<span>Consultar por WhatsApp</span>
					</a>
					<a 
						href="#proyectos" 
						class="flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-zinc-800 hover:border-zinc-600 bg-zinc-900/70 hover:bg-zinc-900 text-zinc-200 hover:text-white font-medium text-xs uppercase tracking-wider transition-all duration-200 active:scale-95"
					>
						<span>Ver ejemplos de trabajo</span>
						<span>&darr;</span>
					</a>
				</div>

				<!-- Métricas Reales orientadas a Negocio -->
				<div class="mt-14 sm:mt-16 grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 w-full max-w-4xl text-left font-mono">
					<div class="p-3.5 sm:p-4 rounded-lg border border-zinc-800/80 bg-zinc-950/70 backdrop-blur-sm">
						<div class="text-[10px] sm:text-xs text-zinc-500 uppercase">Velocidad</div>
						<div class="text-xl sm:text-2xl font-bold text-lime-400 mt-1">&lt; 1 segundo</div>
						<div class="text-[10px] text-zinc-400 mt-0.5">Apertura instantánea</div>
					</div>
					<div class="p-3.5 sm:p-4 rounded-lg border border-zinc-800/80 bg-zinc-950/70 backdrop-blur-sm">
						<div class="text-[10px] sm:text-xs text-zinc-500 uppercase">Tiendas Online</div>
						<div class="text-xl sm:text-2xl font-bold text-white mt-1">100% Propias</div>
						<div class="text-[10px] text-zinc-400 mt-0.5">Sin comisión por venta</div>
					</div>
					<div class="p-3.5 sm:p-4 rounded-lg border border-zinc-800/80 bg-zinc-950/70 backdrop-blur-sm">
						<div class="text-[10px] sm:text-xs text-zinc-500 uppercase">Dispositivos</div>
						<div class="text-xl sm:text-2xl font-bold text-lime-400 mt-1">Celular 1st</div>
						<div class="text-[10px] text-zinc-400 mt-0.5">Adaptado a pantallas táctiles</div>
					</div>
					<div class="p-3.5 sm:p-4 rounded-lg border border-zinc-800/80 bg-zinc-950/70 backdrop-blur-sm">
						<div class="text-[10px] sm:text-xs text-zinc-500 uppercase">Modalidad</div>
						<div class="text-xl sm:text-2xl font-bold text-white mt-1">Llave en mano</div>
						<div class="text-[10px] text-zinc-400 mt-0.5">Diseño, cobros y puesta en marcha</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Vitrina de Trabajos y Proyectos -->
		<section id="proyectos" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-24 border-t border-zinc-800/80">
			<div class="flex flex-col md:flex-row md:items-end justify-between mb-10 sm:mb-12 gap-4">
				<div>
					<div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-lime-400 mb-2">
						<span>// 01</span>
						<span>Vitrina de Trabajos</span>
					</div>
					<h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
						Soluciones para tu negocio
					</h2>
				</div>
				<p class="text-sm text-zinc-400 max-w-md font-sans leading-relaxed">
					Proyectos desarrollados a medida, con diseño atractivo y preparados para recibir visitas, pedidos y pagos de inmediato.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
				{proyectos.map((proyecto) => (
					<ProjectCard {...proyecto} />
				))}
			</div>
		</section>

		<!-- Qué Ofrezco (Servicios Claros) -->
		<section id="servicios" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-24 border-t border-zinc-800/80">
			<div class="mb-10 sm:mb-12">
				<div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-lime-400 mb-2">
					<span>// 02</span>
					<span>Qué Ofrezco</span>
				</div>
				<h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
					Servicios diseñados para dar resultados
				</h2>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-5">
				{servicios.map((s) => (
					<div class="rounded-xl border border-zinc-800 bg-zinc-900/30 p-6 sm:p-7 flex flex-col justify-between hover:border-lime-400/40 transition-all duration-300">
						<div>
							<div class="text-xs font-mono text-lime-400 font-bold mb-4">[{s.numero} // SERVICIO]</div>
							<h3 class="text-xl font-bold text-white mb-3 tracking-tight">{s.titulo}</h3>
							<p class="text-sm text-zinc-400 leading-relaxed font-sans">
								{s.descripcion}
							</p>
						</div>
						<div class="mt-6 pt-4 border-t border-zinc-800/60 flex items-center gap-2 text-xs font-mono text-zinc-400">
							<span class="w-1.5 h-1.5 rounded-full bg-lime-400"></span>
							<span>{s.destaque}</span>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- Por Qué Trabajar Conmigo (Beneficios) -->
		<section id="beneficios" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-24 border-t border-zinc-800/80">
			<div class="mb-10 sm:mb-12">
				<div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-lime-400 mb-2">
					<span>// 03</span>
					<span>Por Qué Elegirme</span>
				</div>
				<h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
					Beneficios claros para tu proyecto
				</h2>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
				{beneficios.map((b) => (
					<div class="p-5 rounded-lg border border-zinc-800/70 bg-zinc-950/60 flex flex-col justify-between hover:border-zinc-700 transition-colors">
						<div>
							<div class="flex items-center gap-2 text-lime-400 text-xs font-mono mb-2">
								<span>&check;</span>
								<h3 class="text-white font-bold text-sm tracking-tight">{b.titulo}</h3>
							</div>
							<p class="text-xs text-zinc-400 font-sans leading-relaxed mt-2">
								{b.desc}
							</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- Sección de Contacto Directo Táctil -->
		<section id="contacto" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-28 border-t border-zinc-800/80">
			<div class="relative rounded-2xl border border-zinc-800 bg-gradient-to-b from-zinc-900/60 via-zinc-900/30 to-[#090a0f] p-6 sm:p-14 overflow-hidden">
				<div class="absolute top-0 right-0 w-80 h-80 bg-lime-400/5 rounded-full blur-3xl pointer-events-none"></div>

				<div class="max-w-2xl mx-auto text-center relative z-10">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono text-lime-400 bg-lime-400/10 border border-lime-400/20 mb-6">
						<span>// CONVERSEMOS DE TU IDEA</span>
					</div>

					<h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
						¿Tienes una idea o necesitas una web para tu negocio?
					</h2>
					<p class="mt-4 text-zinc-300 text-sm sm:text-base leading-relaxed font-sans">
						Escríbeme por WhatsApp y te oriento sin compromiso sobre cómo llevar a cabo tu proyecto de forma ágil y con un presupuesto claro.
					</p>

					<!-- Opciones de Contacto Táctiles (Mobile First) -->
					<div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 font-mono">
						<!-- Botón directo de WhatsApp (Canal Inmediato) -->
						<a 
							href="https://wa.me/5491170603106?text=Hola%20Javier,%20estuve%20viendo%20tu%20web%20y%20me%20gustar%C3%ADa%20consultarte%20por%20un%20proyecto" 
							target="_blank"
							rel="noopener noreferrer"
							class="w-full sm:w-auto flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-lime-400 hover:bg-lime-300 text-black font-bold text-xs uppercase tracking-wider transition-all duration-200 shadow-lg shadow-lime-400/15 glow-lime active:scale-95"
						>
							<svg class="w-4 h-4 fill-current text-black" viewBox="0 0 24 24">
								<path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.83.81 2.796.81 3.183 0 5.769-2.588 5.77-5.768.001-3.182-2.585-5.794-5.77-5.794zm3.364 8.167c-.14.394-.808.751-1.121.789-.313.039-.707.054-2.072-.511-1.745-.724-2.871-2.496-2.958-2.612-.087-.116-.708-.941-.708-1.795 0-.853.447-1.274.607-1.448.16-.174.348-.218.464-.218.116 0 .232.001.333.006.107.005.25.04.385.367.14.339.479 1.168.521 1.255.042.087.07.189.012.305-.058.116-.087.189-.174.291-.087.102-.183.228-.261.306-.087.087-.178.182-.077.355.101.174.45 0.742.966 1.202.664.591 1.224.774 1.398.861.174.087.276.073.378-.044.102-.116.435-.508.551-.682.116-.174.232-.145.392-.087.16.058 1.015.479 1.189.566.174.087.29.131.333.204.043.073.043.421-.097.815zM12.042 2C6.5 2 2 6.5 2 12.042c0 1.984.58 3.834 1.583 5.399L2 22l4.693-1.536c1.517.937 3.303 1.478 5.349 1.478 5.542 0 10.042-4.5 10.042-10.042C22.084 6.5 17.584 2 12.042 2z"/>
							</svg>
							<span>Escribirme al WhatsApp (+54 9 11 7060-3106)</span>
						</a>

						<!-- Botón directo de correo -->
						<a 
							href="mailto:javierams1998@gmail.com" 
							class="w-full sm:w-auto flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl border border-zinc-700 bg-zinc-900/80 hover:bg-zinc-800 text-zinc-200 hover:text-white font-medium text-xs uppercase tracking-wider transition-all active:scale-95"
						>
							<span>Enviar Correo</span>
							<span>&rarr;</span>
						</a>

						<!-- Botón táctil para copiar email con feedback visual -->
						<button 
							id="copy-email-btn"
							type="button"
							data-email="javierams1998@gmail.com"
							class="w-full sm:w-auto flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl border border-zinc-800 bg-zinc-950/80 hover:bg-zinc-900 text-zinc-300 font-medium text-xs uppercase tracking-wider transition-all active:scale-95"
						>
							<span id="copy-text">Copiar Email</span>
						</button>
					</div>

					<div id="copy-feedback" class="mt-3 text-xs font-mono text-lime-400 opacity-0 transition-opacity duration-300">
						&check; javierams1998@gmail.com copiado al portapapeles
					</div>
				</div>
			</div>
		</section>
	</main>

	<!-- Botón Flotante Sutil de WhatsApp con tu número real -->
	<WhatsAppButton phone="5491170603106" />

	<!-- Footer Técnico pero accesible -->
	<footer class="border-t border-zinc-800/80 py-10 text-xs font-mono text-zinc-500 bg-[#07080c]">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
			<div class="flex items-center gap-2">
				<span class="w-1.5 h-1.5 rounded-full bg-lime-400"></span>
				<p>&copy; {new Date().getFullYear()} Javier Moreno. Full Stack Developer & Product Builder.</p>
			</div>
			<div class="flex items-center gap-4 text-zinc-400">
				<a href="https://wa.me/5491170603106" target="_blank" rel="noopener noreferrer" class="hover:text-lime-400 transition-colors">
					WhatsApp: +54 9 11 7060-3106
				</a>
				<span>&bull;</span>
				<span class="text-lime-400 font-semibold">Carga Inmediata</span>
			</div>
		</div>
	</footer>
</Layout>

<script>
	function setupCopyEmail() {
		const copyBtn = document.getElementById('copy-email-btn');
		const feedback = document.getElementById('copy-feedback');
		const copyText = document.getElementById('copy-text');

		if (!copyBtn || !feedback || !copyText) return;

		copyBtn.addEventListener('click', async () => {
			const email = copyBtn.getAttribute('data-email') || 'javierams1998@gmail.com';
			try {
				await navigator.clipboard.writeText(email);
				const original = copyText.textContent;
				copyText.textContent = '¡Copiado!';
				feedback.style.opacity = '1';

				setTimeout(() => {
					copyText.textContent = original;
					feedback.style.opacity = '0';
				}, 2500);
			} catch {
				window.location.href = `mailto:${email}`;
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupCopyEmail);
	} else {
		setupCopyEmail();
	}
	document.addEventListener('astro:page-load', setupCopyEmail);
</script>
