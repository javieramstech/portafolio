---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Vitrina de proyectos con perfil industrial y técnico
const proyectos = [
	{
		id: "01",
		titulo: "Portal Corporativo & Engine Web",
		subtitulo: "Astro // Tailwind // SEO Engine",
		descripcion: "Sitio web corporativo de velocidad crítica, estructurado con arquitectura de islas, 100/100 en Core Web Vitals y diseño editorial de alta conversión.",
		tags: ["Astro", "TailwindCSS", "SEO", "TypeScript"],
		estado: "Disponible",
		link: "#",
		destacado: true
	},
	{
		id: "02",
		titulo: "E-Commerce de Alta Fidelidad",
		subtitulo: "UX // Performance // UI Minimal",
		descripcion: "Catálogo interactivo enfocado en mobile-first con carga diferida de recursos, micro-interacciones táctiles y navegación sin fricción.",
		tags: ["Diseño UI/UX", "Mobile First", "Rendimiento"],
		estado: "En proceso",
		link: "#",
		destacado: false
	},
	{
		id: "03",
		titulo: "Panel de Datos & UI Técnica",
		subtitulo: "Frontend // Dashboard // a11y",
		descripcion: "Interfaz analítica contemporánea con contraste optimizado, navegación por teclado accesible (WCAG AAA) y componentes modulares.",
		tags: ["Frontend", "Accesibilidad", "Componentes"],
		estado: "Concepto",
		link: "#",
		destacado: false
	}
];

const techStack = [
	{ nombre: "Astro", categoria: "Core Framework", desc: "Arquitectura de islas y cero JS superfluo" },
	{ nombre: "Tailwind CSS v4", categoria: "Styling Engine", desc: "Sistemas de diseño escalables y precisos" },
	{ nombre: "TypeScript", categoria: "Tipado Estricto", desc: "Código robusto y libre de regresiones" },
	{ nombre: "Figma & UI Design", categoria: "Diseño de Interfaz", desc: "Prototipos interactivos y tipografía editorial" },
	{ nombre: "Git & CI/CD", categoria: "Versionado", desc: "Flujos de despliegue continuo en la nube" },
	{ nombre: "Core Web Vitals", categoria: "Optimización", desc: "Lighthouse 100/100 garantizado" }
];
---

<Layout title="Javier Moreno — Desarrollador Web & UI Engineer">
	<Navbar />

	<main class="flex-1">
		<!-- Hero Section con Canvas Interactivo Táctil -->
		<section 
			id="hero-section" 
			class="relative min-h-[88vh] sm:min-h-[92vh] flex items-center justify-center px-4 sm:px-6 pt-16 pb-20 overflow-hidden bg-tech-grid"
		>
			<HeroCanvas />

			<!-- Contenedor de contenido Hero (Mobile First) -->
			<div class="relative z-10 max-w-5xl mx-auto text-center flex flex-col items-center">
				<!-- Live System Status Badge -->
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-mono border border-zinc-800 bg-zinc-900/80 text-zinc-300 mb-8 backdrop-blur-md glow-lime-sm">
					<span class="w-2 h-2 rounded-full bg-lime-400 animate-pulse"></span>
					<span class="text-lime-400 font-semibold">[SYS: ONLINE]</span>
					<span class="text-zinc-500">|</span>
					<span>Disponible para nuevos proyectos</span>
				</div>

				<!-- Titular Principal con Alto Impacto y Personalidad -->
				<h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white leading-[1.08] max-w-4xl text-balance">
					Construyo productos web de <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-100 to-zinc-400">alto impacto</span> y <span class="text-lime-400 underline decoration-lime-400/40 decoration-wavy decoration-1 underline-offset-8">precisión técnica</span>.
				</h1>

				<!-- Subtítulo técnico claro y sin rodeos -->
				<p class="mt-6 text-base sm:text-xl text-zinc-400 max-w-2xl font-normal leading-relaxed text-pretty">
					Especializado en interfaces modernas, velocidad extrema y arquitectura limpia con <span class="text-zinc-200 font-medium">Astro</span>. Cero plantillas genéricas. Experiencias fluidas pensadas desde el móvil.
				</p>

				<!-- Botones de Acción Táctiles (Móvil Primero con min 48px de altura) -->
				<div class="mt-8 sm:mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4 w-full sm:w-auto items-stretch sm:items-center justify-center">
					<a 
						href="#proyectos" 
						class="flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-lime-400 hover:bg-lime-300 text-black font-bold text-sm font-mono uppercase tracking-wider transition-all duration-200 glow-lime active:scale-95"
					>
						<span>Ver proyectos</span>
						<span class="text-xs">&darr;</span>
					</a>
					<a 
						href="#contacto" 
						class="flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-zinc-800 hover:border-zinc-600 bg-zinc-900/60 hover:bg-zinc-900 text-zinc-200 hover:text-white font-medium text-sm font-mono transition-all duration-200 active:scale-95"
					>
						<span>Iniciar conversación</span>
						<span>&rarr;</span>
					</a>
				</div>

				<!-- Strip de Métricas de Rendimiento en Vivo -->
				<div class="mt-14 sm:mt-16 grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 w-full max-w-4xl text-left font-mono">
					<div class="p-3 sm:p-4 rounded-lg border border-zinc-800/80 bg-zinc-950/70 backdrop-blur-sm">
						<div class="text-[10px] sm:text-xs text-zinc-500 uppercase">Rendimiento</div>
						<div class="text-xl sm:text-2xl font-bold text-lime-400 mt-1">100/100</div>
						<div class="text-[10px] text-zinc-400 mt-0.5">Lighthouse Score</div>
					</div>
					<div class="p-3 sm:p-4 rounded-lg border border-zinc-800/80 bg-zinc-950/70 backdrop-blur-sm">
						<div class="text-[10px] sm:text-xs text-zinc-500 uppercase">Carga Cliente</div>
						<div class="text-xl sm:text-2xl font-bold text-white mt-1">0 KB JS</div>
						<div class="text-[10px] text-zinc-400 mt-0.5">Por defecto con islas</div>
					</div>
					<div class="p-3 sm:p-4 rounded-lg border border-zinc-800/80 bg-zinc-950/70 backdrop-blur-sm">
						<div class="text-[10px] sm:text-xs text-zinc-500 uppercase">Velocidad LCP</div>
						<div class="text-xl sm:text-2xl font-bold text-lime-400 mt-1">&lt; 0.8s</div>
						<div class="text-[10px] text-zinc-400 mt-0.5">Carga instantánea</div>
					</div>
					<div class="p-3 sm:p-4 rounded-lg border border-zinc-800/80 bg-zinc-950/70 backdrop-blur-sm">
						<div class="text-[10px] sm:text-xs text-zinc-500 uppercase">Enfoque</div>
						<div class="text-xl sm:text-2xl font-bold text-white mt-1">Mobile 1st</div>
						<div class="text-[10px] text-zinc-400 mt-0.5">Diseño táctil accesible</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Vitrina de Proyectos Seleccionados -->
		<section id="proyectos" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-24 border-t border-zinc-800/80">
			<div class="flex flex-col md:flex-row md:items-end justify-between mb-10 sm:mb-12 gap-4">
				<div>
					<div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-lime-400 mb-2">
						<span>// 01</span>
						<span>Vitrina Técnica</span>
					</div>
					<h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
						Proyectos seleccionados
					</h2>
				</div>
				<p class="text-sm text-zinc-400 max-w-md font-sans leading-relaxed">
					Cada desarrollo es autónomo, alojado con costo cero de infraestructura y optimizado para máxima conversión y velocidad.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
				{proyectos.map((proyecto) => (
					<ProjectCard {...proyecto} />
				))}
			</div>
		</section>

		<!-- Arquitectura y Filosofía (Bento Grid Industrial) -->
		<section id="enfoque" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-24 border-t border-zinc-800/80">
			<div class="mb-10 sm:mb-12">
				<div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-lime-400 mb-2">
					<span>// 02</span>
					<span>Arquitectura & Métodos</span>
				</div>
				<h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
					Cómo marco la diferencia
				</h2>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-5">
				<!-- Card 01 -->
				<div class="rounded-xl border border-zinc-800 bg-zinc-900/30 p-6 sm:p-7 flex flex-col justify-between hover:border-zinc-700 transition-colors">
					<div>
						<div class="text-xs font-mono text-lime-400 font-bold mb-4">[METRIC: SPEED]</div>
						<h3 class="text-lg font-bold text-white mb-2">Velocidad que Convierte</h3>
						<p class="text-sm text-zinc-400 leading-relaxed">
							Un segundo de retraso cuesta hasta el 20% de visitas. Al usar Astro, tus páginas cargan de inmediato sin scripts pesados de fondo.
						</p>
					</div>
					<div class="mt-6 pt-4 border-t border-zinc-800/60 flex items-center gap-2 text-xs font-mono text-zinc-500">
						<span class="w-1.5 h-1.5 rounded-full bg-lime-400"></span>
						<span>Tiempo de respuesta óptimo</span>
					</div>
				</div>

				<!-- Card 02 -->
				<div class="rounded-xl border border-zinc-800 bg-zinc-900/30 p-6 sm:p-7 flex flex-col justify-between hover:border-zinc-700 transition-colors">
					<div>
						<div class="text-xs font-mono text-lime-400 font-bold mb-4">[DESIGN: ANTI-CLICHÉ]</div>
						<h3 class="text-lg font-bold text-white mb-2">Diseño con Identidad Real</h3>
						<p class="text-sm text-zinc-400 leading-relaxed">
							Sin plantillas predecibles ni estilos genéricos. Cada proyecto tiene proporciones cuidadas, tipografía expresiva y armonía visual.
						</p>
					</div>
					<div class="mt-6 pt-4 border-t border-zinc-800/60 flex items-center gap-2 text-xs font-mono text-zinc-500">
						<span class="w-1.5 h-1.5 rounded-full bg-lime-400"></span>
						<span>Acabado contemporáneo</span>
					</div>
				</div>

				<!-- Card 03 -->
				<div class="rounded-xl border border-zinc-800 bg-zinc-900/30 p-6 sm:p-7 flex flex-col justify-between hover:border-zinc-700 transition-colors">
					<div>
						<div class="text-xs font-mono text-lime-400 font-bold mb-4">[HOSTING: FREE TIER]</div>
						<h3 class="text-lg font-bold text-white mb-2">Cero Costo en Servidores</h3>
						<p class="text-sm text-zinc-400 leading-relaxed">
							Arquitectura estática lista para desplegarse globalmente en Cloudflare Pages o Vercel con SSL automático sin tarifas mensuales fijas.
						</p>
					</div>
					<div class="mt-6 pt-4 border-t border-zinc-800/60 flex items-center gap-2 text-xs font-mono text-zinc-500">
						<span class="w-1.5 h-1.5 rounded-full bg-lime-400"></span>
						<span>Escalabilidad global</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Stack Tecnológico -->
		<section id="habilidades" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-24 border-t border-zinc-800/80">
			<div class="mb-10 sm:mb-12">
				<div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-lime-400 mb-2">
					<span>// 03</span>
					<span>Arsenal Tecnológico</span>
				</div>
				<h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
					Tecnologías de alto rendimiento
				</h2>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 font-mono">
				{techStack.map((tech) => (
					<div class="p-4 rounded-lg border border-zinc-800/70 bg-zinc-950/60 flex flex-col justify-between hover:border-lime-400/40 transition-colors">
						<div class="flex items-center justify-between mb-2">
							<span class="text-white font-bold text-sm">{tech.nombre}</span>
							<span class="text-[10px] text-lime-400 bg-lime-400/10 px-2 py-0.5 rounded border border-lime-400/20">
								OK
							</span>
						</div>
						<div class="text-xs text-zinc-400 font-sans mt-1">
							{tech.desc}
						</div>
						<div class="mt-3 text-[10px] text-zinc-500 uppercase tracking-wider">
							{tech.categoria}
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- Sección de Contacto Directo Táctil -->
		<section id="contacto" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-28 border-t border-zinc-800/80">
			<div class="relative rounded-2xl border border-zinc-800 bg-gradient-to-b from-zinc-900/60 via-zinc-900/30 to-[#090a0f] p-6 sm:p-14 overflow-hidden">
				<div class="absolute top-0 right-0 w-80 h-80 bg-lime-400/5 rounded-full blur-3xl pointer-events-none"></div>

				<div class="max-w-2xl mx-auto text-center relative z-10">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono text-lime-400 bg-lime-400/10 border border-lime-400/20 mb-6">
						<span>// CANAL DIRECTO</span>
					</div>

					<h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
						¿Tienes una idea o proyecto en mente?
					</h2>
					<p class="mt-4 text-zinc-400 text-sm sm:text-base leading-relaxed font-sans">
						Hablemos sobre cómo diseñar un sitio web de vanguardia que haga destacar a tu marca. Respondo en menos de 24 horas.
					</p>

					<!-- Botones de Acción de Contacto (Mobile First con feedback para copiar) -->
					<div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 font-mono">
						<!-- Botón directo de correo -->
						<a 
							href="mailto:javierams1998@gmail.com" 
							class="w-full sm:w-auto flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-lime-400 hover:bg-lime-300 text-black font-bold text-xs uppercase tracking-wider transition-all duration-200 glow-lime-sm active:scale-95"
						>
							<span>Enviar Correo Directo</span>
							<span>&rarr;</span>
						</a>

						<!-- Botón táctil para copiar email con feedback visual -->
						<button 
							id="copy-email-btn"
							type="button"
							data-email="javierams1998@gmail.com"
							class="w-full sm:w-auto flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-zinc-700 bg-zinc-900/80 hover:bg-zinc-800 text-zinc-200 font-medium text-xs uppercase tracking-wider transition-all active:scale-95"
						>
							<span id="copy-text">Copiar javierams1998@gmail.com</span>
						</button>
					</div>

					<div id="copy-feedback" class="mt-3 text-xs font-mono text-lime-400 opacity-0 transition-opacity duration-300">
						&check; Correo copiado al portapapeles
					</div>
				</div>
			</div>
		</section>
	</main>

	<!-- Footer Técnico -->
	<footer class="border-t border-zinc-800/80 py-10 text-xs font-mono text-zinc-500 bg-[#07080c]">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
			<div class="flex items-center gap-2">
				<span class="w-1.5 h-1.5 rounded-full bg-lime-400"></span>
				<p>&copy; {new Date().getFullYear()} Javier Moreno. Todos los derechos reservados.</p>
			</div>
			<div class="flex items-center gap-4 text-zinc-400">
				<span>BUILD // ASTRO + TAILWIND</span>
				<span>&bull;</span>
				<span class="text-lime-400 font-semibold">100% LIGHTHOUSE</span>
			</div>
		</div>
	</footer>
</Layout>

<script>
	function setupCopyEmail() {
		const copyBtn = document.getElementById('copy-email-btn');
		const feedback = document.getElementById('copy-feedback');
		const copyText = document.getElementById('copy-text');

		if (!copyBtn || !feedback || !copyText) return;

		copyBtn.addEventListener('click', async () => {
			const email = copyBtn.getAttribute('data-email') || 'javierams1998@gmail.com';
			try {
				await navigator.clipboard.writeText(email);
				const original = copyText.textContent;
				copyText.textContent = '¡Copiado con éxito!';
				feedback.style.opacity = '1';

				setTimeout(() => {
					copyText.textContent = original;
					feedback.style.opacity = '0';
				}, 2500);
			} catch {
				window.location.href = `mailto:${email}`;
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupCopyEmail);
	} else {
		setupCopyEmail();
	}
	document.addEventListener('astro:page-load', setupCopyEmail);
</script>
