---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

// Proyectos orientados al valor real de negocio para clientes
const proyectos = [
	{
		id: "01",
		titulo: "Tienda Online & E-Commerce a Medida",
		subtitulo: "E-Commerce // Pagos Online // Catálogo Propio",
		descripcion: "Plataforma de venta online completa desarrollada desde cero. Catálogo de productos ágil, cobro seguro con tarjeta (MercadoPago / Stripe) y sin pagar comisiones por venta a plataformas de terceros.",
		tags: ["Tienda Online", "Cobro con Tarjeta", "Sin Comisiones", "Super Rápida"],
		estado: "Disponible",
		link: "https://wa.me/5491170603106?text=Hola%20Javier,%20me%20interesa%20saber%20m%C3%A1s%20sobre%20una%20tienda%20online%20para%20mi%20negocio",
		destacado: true
	},
	{
		id: "02",
		titulo: "Página Web Corporativa de Alta Conversión",
		subtitulo: "Web Profesional // Captación de Clientes // Google",
		descripcion: "Sitio web elegante y moderno para empresas y profesionales. Diseñado para transmitir máxima confianza, posicionar en Google y lograr que los visitantes te contacten directamente a tu WhatsApp o correo.",
		tags: ["Página Web", "Diseño a Medida", "Posicionamiento Google", "100% Celulares"],
		estado: "Disponible",
		link: "https://wa.me/5491170603106?text=Hola%20Javier,%20me%20gustar%C3%ADa%20una%20p%C3%A1gina%20web%20corporativa%20para%20mi%20empresa",
		destacado: false
	},
	{
		id: "03",
		titulo: "Sistema Web & Panel de Gestión",
		subtitulo: "App Web // Control de Pedidos // Clientes",
		descripcion: "Panel administrativo privado para gestionar tu negocio: control de inventario, registro de ventas, citas o usuarios. Todo accesible de forma segura desde tu computadora o teléfono móvil.",
		tags: ["Panel de Control", "Automatización", "Base de Datos", "Seguro"],
		estado: "Concepto",
		link: "https://wa.me/5491170603106?text=Hola%20Javier,%20necesito%20un%20sistema%20web%20o%20panel%20para%20mi%20negocio",
		destacado: false
	}
];

const servicios = [
	{
		numero: "01",
		titulo: "Tiendas Online & E-Commerce",
		descripcion: "Armo tu tienda virtual desde cero para que vendas 24/7 sin intermediarios. Con carrito de compras, cobro automático con tarjeta de débito/crédito y gestión de productos fácil.",
		destaque: "Cobro automático y catálogo propio"
	},
	{
		numero: "02",
		titulo: "Páginas Web para Empresas & Marcas",
		descripcion: "Una presencia digital que destaque a tu negocio de la competencia. Diseño visual a medida, carga instantánea y optimización para que tus clientes te encuentren en Google.",
		destaque: "Atrae clientes y transmite confianza"
	},
	{
		numero: "03",
		titulo: "Sistemas & Aplicaciones a Medida",
		descripcion: "Si necesitas un panel interno para gestionar clientes, pedidos, inventario o reservas, creo herramientas web privadas, rápidas y muy fáciles de usar para tu equipo.",
		destaque: "Ahorra tiempo y automatiza tu trabajo"
	}
];

const beneficios = [
	{ 
		titulo: "Trato 100% Directo", 
		desc: "Hablas directamente conmigo sin intermediarios, burocracia ni sobreprecios de agencias." 
	},
	{ 
		titulo: "Carga en menos de 1 segundo", 
		desc: "Un sitio web lento hace perder ventas. Mis páginas abren al instante incluso con datos móviles." 
	},
	{ 
		titulo: "Diseño Único y Profesional", 
		desc: "Cero plantillas genéricas. Tu sitio tendrá una identidad visual cuidada que impresiona a primera vista." 
	},
	{ 
		titulo: "100% Pensado para Celulares", 
		desc: "Más del 80% de tus clientes te verán desde el teléfono; la experiencia móvil es impecable y cómoda." 
	},
	{ 
		titulo: "El Proyecto es Tuyo", 
		desc: "Eres dueño total de tu código y datos. Sin ataduras a suscripciones abusivas de plataformas cerradas." 
	},
	{ 
		titulo: "Listo para Vender", 
		desc: "Botones directos de WhatsApp, llamadas y formularios para que ningún cliente se quede con dudas." 
